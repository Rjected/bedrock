# Build a single module combining Rust and C code
obj-m := bedrock.o

# Link the Rust main module with C helpers and assembly
bedrock-y := bedrock_main.o helpers.o vmx_support.o svm_support.o

# Recent distro kernels reserve the CR4 shadow update API for KVM modules.
# AMD SVM does not use CR4.VMXE; this mode omits that Intel-only dependency.
ifeq ($(SVM_ONLY),1)
ccflags-y += -DBEDROCK_SVM_ONLY
KBUILD_RUSTFLAGS += --cfg svm_only
endif

# Enable kernel pr_* logging macros (pass KERNEL_LOG=1 to make)
ifdef KERNEL_LOG
KBUILD_RUSTFLAGS += --cfg kernel_log
endif
