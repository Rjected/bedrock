#!/bin/sh
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

# Stage 1: Switch from initramfs to real tmpfs root (required for pivot_root in containers)
if [ ! -f /switched_root ]; then
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs devtmpfs /dev

    mkdir -p /newroot
    # The root holds the rootfs, the downloaded images.tar and all container
    # storage, which is most of what the guest stores; let it use all of RAM
    # rather than ENOSPC while RAM is still free (tmpfs pages are only
    # allocated as written, and overcommit ends in the OOM killer either way).
    mount -t tmpfs -o size=100% tmpfs /newroot

    # Copy filesystem to new root
    cp -a /bin /newroot/ 2>/dev/null || true
    cp -a /sbin /newroot/ 2>/dev/null || true
    cp -a /lib /newroot/ 2>/dev/null || true
    cp -a /lib64 /newroot/ 2>/dev/null || true
    cp -a /usr /newroot/ 2>/dev/null || true
    cp -a /etc /newroot/ 2>/dev/null || true
    cp -a /var /newroot/ 2>/dev/null || true
    cp -a /nix /newroot/ 2>/dev/null || true
    cp -a /images /newroot/ 2>/dev/null || true
    cp -a /workload /newroot/ 2>/dev/null || true
    cp -a /init /newroot/

    mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run /newroot/tmp
    mkdir -p /newroot/dev/shm /newroot/dev/pts /newroot/sys/fs/cgroup
    mkdir -p /newroot/var/lib/containers

    touch /newroot/switched_root
    exec switch_root /newroot /init
fi

# Stage 2: Setup after switch_root
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/shm /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t devpts devpts /dev/pts
mount -t cgroup2 cgroup2 /sys/fs/cgroup

# Send kernel printk to the journal only, not straight to the console.
# journald imports /dev/kmsg, and the `journalctl -f` tail started later
# renders it on the serial console. Without this, every kernel line — e.g.
# bedrock-io's per-command worker traces — would print twice: once via the
# printk console (console=hvc0) and once via journalctl. Lowering
# console_loglevel to 1 keeps the printk console quiet for everything below
# KERN_EMERG, so a panic is still visible directly even if journald is wedged.
# (The kernel's pre-init boot banner, printed before /init runs, still reaches
# the console natively; it also appears once in the journal.)
echo 1 > /proc/sys/kernel/printk

# Create directories needed for containers and networking
mkdir -p /run/netns /var/run/netns /run/containers/storage /var/lib/cni /var/tmp

# Load the paravirtual batch console as early as possible so that
# kernel printk output for the rest of boot is shipped one line per
# VMCALL instead of one byte per VMX I/O exit through the emulated
# 8250. The cmdline selects it with console=hvc0; earlyprintk=serial
# covers the pre-registration window. Failure is non-fatal — the guest
# keeps logging through earlyprintk/8250. Userspace stdout is sent to
# /dev/ttyS0 below (the 8250 tty, unchanged), since this console is a
# write-only printk console with no tty backing /dev/console.
insmod /lib/modules/bedrock-console.ko || \
    echo "bedrock-console: insmod failed (continuing without batch console)"

# Load the deterministic I/O channel module. Must come after the
# filesystem is in place (kernel_read_file_from_path needs /tmp on
# tmpfs) but before podman-compose, since the I/O actions exec into
# the containers that compose brings up. Failure is non-fatal in case
# the module ABI is mismatched against the running kernel.
insmod /lib/modules/bedrock-io.ko || \
    echo "bedrock-io: insmod failed (continuing without I/O channel)"

# Redirect output to the console. /dev/console now routes to the
# paravirtual batch console (hvc0): bedrock-console.ko registers a tty
# whose .write batches whole buffers to the hypervisor in one VMCALL, and
# the console's .device points /dev/console at it. So both kernel printk
# and this userspace output go through hvc0, one VM exit per line instead
# of one per byte through the emulated 8250.
exec >/dev/console 2>&1

# Start systemd-journald standalone (no PID 1 systemd). conmon
# connects to its socket directly when `log_driver = "journald"`
# is set in containers.conf, so every container's stdout/stderr
# lands in the journal as a structured record (CONTAINER_NAME,
# MESSAGE, PRIORITY, …). bedrock-io's exec output is piped
# through `systemd-cat -t bedrock-exec` for the same treatment.
# The unified journal becomes the single source the formatter
# below tails — no per-container follower bookkeeping, no
# re-attach loops on stop/start.
mkdir -p /run/systemd/journal /run/log/journal
@systemd@/lib/systemd/systemd-journald 2> /dev/null &
# Wait for the socket so the first podman/conmon connect doesn't
# race the daemon's bind.
while [ ! -S /run/systemd/journal/socket ]; do
    sleep 0.05
done

# Register a PEBS scratch page with the hypervisor so precise VM exits
# (timer interrupt injection, stop-at-tsc) can trap on EPT writes. The
# program registers, then blocks forever to keep the page pinned, so we
# background it. Failure is expected outside bedrock; the workload runs
# regardless.
bedrock-pebs-register | systemd-cat -t init &

# Start the in-kernel concurrency-fuzz scheduler. It attaches the sched_ext
# struct_ops with SCX_OPS_SWITCH_PARTIAL, so only SCHED_EXT tasks are governed
# and everything else stays on stock CFS. A workload opts a process into
# SCHED_EXT by wrapping it in thread-fuzz (bind-mounted into containers, see
# containers.conf), so scx-init must be attached before the workload runs:
# launch it here, backgrounded, since it holds the struct_ops link open for the
# VM's lifetime. Its schedule is driven by the getrandom vmcall, which bedrock
# serves from its controlled, fuzzer-driven stream: deterministic under the
# single vCPU + emulated TSC.
scx-init 2>&1 | systemd-cat -t scx-fuzz &

# Reset podman state
podman system reset -f 2>&1 | systemd-cat -t init || true

# Set up loopback
ip link set lo up | systemd-cat -t init 

# Each assertion writer gets a JSONL file in this directory. Create it before
# any containers start so podman can bind-mount it.
mkdir -p /bedrock/assertions

# Coverage dir: a host-namespace mount bind-mounted into every container (see
# containers.conf volumes). Each instrumented process keeps its feedback bitmap
# as a file here (see guest/libfeedback.c) so the pages — and the coverage they
# hold — outlive the process and the container that produced them. Pre-create
# it before any container starts, for the same reason as the assertion sink.
mkdir -p /bedrock/coverage

# Discover new writer files and forward complete lines, ordered by their
# Unix-nanosecond timestamps, to the journal and serial console.
workload-monitor forward-assertions | systemd-cat -t assertions &

# Start the workload monitor. It tails `podman events` and, on each container
# or exec death, appends an exit-code assertion to its own JSONL file
# (surfaced as `[assertions]` by the forwarder). It prints nothing to
# stdout; only its error diagnostics reach the journal via `systemd-cat`,
# rendered as `[workload-monitor]`.
workload-monitor 2>&1 | systemd-cat -t workload-monitor &

# Download workload files and an optional DST helper from the host over the
# file-transmission hypercall. bedrock-file-fetch registers a 1 MB buffer as the
# transport and pulls each named file in
# chunks. The host serves them (e.g. `bedrock-cli --file compose.yaml=… --file
# images.tar=…`, or the lab's `LabOpts.files`). This happens before the workload
# starts and before the ready hypercall, so it is part of the deterministic
# boot. Failure is fatal to the workload — without the files there is nothing to
# run — but we let init continue so the diagnostics reach the journal.
mkdir -p /workload /images
bedrock-file-fetch \
    compose.yaml /workload/compose.yaml \
    images.tar   /images/images.tar \
    '?tempo-dst' /usr/local/bin/tempo-dst 2>&1 | systemd-cat -t init
fetch_status=${PIPESTATUS[0]}
if [ "$fetch_status" -ne 0 ]; then
    rm -f /usr/local/bin/tempo-dst
    echo "workload file fetch failed" | systemd-cat -t init
elif [ -f /usr/local/bin/tempo-dst ]; then
    chmod +x /usr/local/bin/tempo-dst
fi

# Load all workload images from the single image tarball, then delete it: it
# would otherwise sit in tmpfs (i.e. guest RAM) for the life of the VM. Its
# digest is kept in /images/images.tar.sha256 so its integrity against the host
# original stays verifiable.
#
# `docker save` with the containerd image store writes an OCI layout (gzip
# layers, index.json naming each image). `podman load` of that, read as a
# docker-archive, hands every layer to containers/storage decompressed, and
# storage stages it in a temp file before unpacking: for the ~1.1 GB Tempo
# layer that transient copy alone needs over 1 GB more guest RAM. So such
# archives are unpacked to a directory and each image is pulled through the
# `oci:` transport, which stages the compressed blob instead. The index's ref
# names are rewritten to unique ones (images commonly share `latest`) and each
# image is named from its `io.containerd.image.name`, as `podman load` would.
# Classic docker-archive tarballs still go through `podman load`.
sha256sum /images/images.tar | cut -d' ' -f1 > /images/images.tar.sha256
load_images() {
    local tar=/images/images.tar oci=/images/oci n i id name
    if ! tar -tf "$tar" oci-layout >/dev/null 2>&1; then
        podman load -i "$tar" && rm -f "$tar"
        return
    fi
    mkdir -p "$oci" && tar -xf "$tar" -C "$oci" && rm -f "$tar" || return 1
    jq '.manifests |= (to_entries | map(.value.annotations["org.opencontainers.image.ref.name"] = "bedrock-load-\(.key)" | .value))' \
        "$oci/index.json" > "$oci/index.json.new" && mv "$oci/index.json.new" "$oci/index.json" || return 1
    n=$(jq '.manifests | length' "$oci/index.json") || return 1
    for i in $(seq 0 $((n - 1))); do
        name=$(jq -r ".manifests[$i].annotations[\"io.containerd.image.name\"] // empty" "$oci/index.json")
        id=$(podman pull -q "oci:$oci:bedrock-load-$i") || return 1
        podman untag "$id" && { [ -z "$name" ] || podman tag "$id" "$name"; } || return 1
        echo "Loaded image: ${name:-$id}"
    done
    # Root tmpfs (guest RAM) use with the images loaded and the layout present.
    df -m /
    rm -rf "$oci"
}
load_images 2>&1 | systemd-cat -t init
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo "image load failed; leaving /images for diagnosis" | systemd-cat -t init
fi
echo "Loaded images:" | systemd-cat -t init
podman images 2>&1 | systemd-cat -t init

# Run workload detached. Container output and lifecycle events both
# flow into journald (log_driver = journald, events_logger =
# journald in containers.conf); bedrock-io's exec actions feed it
# via systemd-cat. journalctl -f -o json then drains the unified
# stream as structured JSON records and the host renders them for
# display. This replaces the previous per-container follow-loop
# entirely — restart resilience is now journald's problem, not ours.
# Debug: report which OCI runtime podman will actually use (stock crun; the
# fuzzing scheduler is opt-in per workload via thread-fuzz, not the runtime).
podman info --format 'OCIRuntime: {{.Host.OCIRuntime.Name}} -> {{.Host.OCIRuntime.Path}}' 2>&1 \
    | systemd-cat -t init

cd /workload
podman-compose up -d | systemd-cat -t init

# The journal is the single console source for the runtime phase: it carries
# container output, the systemd-cat tags (assertions, workload-monitor,
# bedrock-io exec output) AND kernel printk (journald imports /dev/kmsg). The
# printk console itself is silenced in stage 2 (console_loglevel=1), so kernel
# lines reach the serial console only here — once — instead of twice.
# Project each record down to the two fields the host needs: SYSLOG_IDENTIFIER
# (the source label) and MESSAGE. SYSLOG_IDENTIFIER alone identifies every
# source — conmon sets it to the container name for container output, systemd-cat
# sets it to the `-t` tag (assertions, workload-monitor, init, bedrock-io exec),
# and kernel records carry "kernel" — so CONTAINER_NAME is redundant.
# `journalctl -o json` always emits every field (and forces protected ones like
# __CURSOR, the timestamps and _BOOT_ID, which --output-fields can't drop), so
# filter with jq. `-c` keeps one compact object per line; `-M` forces monochrome
# (jq writes to the hvc0 TTY and would otherwise colourise); `--unbuffered`
# flushes per line so the host sees records live. The host (bedrock-cli) renders
# each record as `[source] | message` with a per-source colour; tests parse the
# records directly.
journalctl -f -o json --no-tail | jq -cM --unbuffered '{SYSLOG_IDENTIFIER, MESSAGE}' &

# Block until the shutdown VMCALL terminates the VM.
wait

# Drop to an interactive shell on the 8250 serial tty. The hvc0 batch
# console is output-only (no get_chars/input path), so the interactive
# fallback shell uses /dev/ttyS0, which carries host-fed serial input.
# This only runs in manual sessions — under the fuzzer/determinism
# harness the VM is terminated by the shutdown VMCALL before here.
exec setsid sh -c 'exec sh </dev/ttyS0 >/dev/ttyS0 2>&1'
