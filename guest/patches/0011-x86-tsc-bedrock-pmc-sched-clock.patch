--- a/arch/x86/kernel/tsc.c
+++ b/arch/x86/kernel/tsc.c
@@ -64,6 +64,18 @@
 }
 early_param("bedrock_pmc_clock", bedrock_pmc_clock_setup);
 
+/* Keep sched_clock's current tick in the clocksource's PMC domain. */
+static __always_inline u64 bedrock_sched_clock_cycles(void)
+{
+	if (unlikely(bedrock_pmc_clock)) {
+		u32 low, high;
+
+		asm volatile("rdpmc" : "=a" (low), "=d" (high) : "c" (1));
+		return ((u64)(high & 0xffff) << 32) | low;
+	}
+	return rdtsc();
+}
+
 static struct clocksource_base art_base_clk = {
 	.id    = CSID_X86_ART,
 };
@@ -216,7 +228,7 @@
 	struct cyc2ns *c2n = this_cpu_ptr(&cyc2ns);
 
 	seqcount_latch_init(&c2n->seq);
-	__set_cyc2ns_scale(tsc_khz, smp_processor_id(), rdtsc());
+	__set_cyc2ns_scale(tsc_khz, smp_processor_id(), bedrock_sched_clock_cycles());
 }
 
 /*
@@ -246,7 +258,7 @@
 noinstr u64 native_sched_clock(void)
 {
 	if (static_branch_likely(&__use_tsc)) {
-		u64 tsc_now = rdtsc();
+		u64 tsc_now = bedrock_sched_clock_cycles();
 
 		/* return the value in ns */
 		return __cycles_2_ns(tsc_now);
@@ -1055,7 +1067,7 @@
 		if (!(freq->flags & CPUFREQ_CONST_LOOPS))
 			mark_tsc_unstable("cpufreq changes");
 
-		set_cyc2ns_scale(tsc_khz, freq->policy->cpu, rdtsc());
+		set_cyc2ns_scale(tsc_khz, freq->policy->cpu, bedrock_sched_clock_cycles());
 	}
 
 	return 0;
